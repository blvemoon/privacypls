# Copy this file to .env and fill it in:  cp .env.example .env
# Never commit .env or paste its contents anywhere public.

# --- Required in production ---
NODE_ENV=production
# From https://console.anthropic.com (Settings -> API keys)
ANTHROPIC_API_KEY=
# A long random value. Generate one with:  openssl rand -hex 32
ALTCHA_HMAC_SECRET=

# --- Site ---
SITE_NAME=privacypls.io
SITE_URL=https://privacypls.io
HOST=127.0.0.1
PORT=3000

# --- AI model ---
# Haiku at launch. Switch to claude-sonnet-5-5 by changing this one line.
MODEL=claude-haiku-5-5
ALLOWED_MODELS=claude-haiku-5-5,claude-sonnet-5-5
MAX_OUTPUT_TOKENS=4000
AI_TIMEOUT_SECONDS=90

# --- Spending protection ---
# The app stops analyzing once this month's AI spend reaches this amount (USD).
# Also set a $20 monthly limit in the Anthropic Console as a backstop.
MONTHLY_BUDGET_USD=18
# One analysis per visitor every this many seconds.
RATE_LIMIT_SECONDS=120
MAX_CONCURRENT_ANALYSES=3
# Longest text accepted, in characters.
MAX_TEXT_CHARS=150000
MIN_TEXT_CHARS=200
# Long text is split into pieces of this size (keeps each request under 100k tokens).
CHUNK_CHARS=60000

# --- Password gate (personal-use mode) ---
# Set a password to require it for every analysis. Leave empty to open the tool to everyone.
ACCESS_PASSWORD=

# --- Bot check ---
# Keep this on in production. Turning it off is only for local testing.
BOT_CHECK_ENABLED=true
# Puzzle difficulty. Higher is harder for bots and slower for people.
ALTCHA_COST=2000

# --- Links (leave empty to hide) ---
DONATION_URL=https://ko-fi.com/bluemoongg
# An email address or a https:// form link. Empty hides the Feedback link and page.
FEEDBACK_CONTACT=

# --- Fetching pages ---
FETCH_TIMEOUT_SECONDS=10
FETCH_MAX_BYTES=2097152
FETCH_MAX_REDIRECTS=5

# --- Files ---
DATA_DIR=data
RULES_FILE=config/rules.json
PRICING_FILE=config/pricing.json
# Shown on the privacy page. Update it whenever the policy text changes.
PRIVACY_LAST_UPDATED=November 12, 2026
