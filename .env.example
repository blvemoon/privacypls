# Settings template. On Vercel, enter these in Project -> Settings ->
# Environment Variables (see docs/DEPLOY.md). For running on your own computer,
# copy this file to .env.local:  cp .env.example .env.local
# Never commit .env.local or paste its contents anywhere public.

# --- Required ---
# From https://console.anthropic.com (Settings -> API keys)
ANTHROPIC_API_KEY=
# Your monthly AI spending limit in US dollars, e.g. a bit under your Anthropic
# Console limit. REQUIRED: if it's missing or invalid, the app refuses analyses.
MONTHLY_BUDGET_USD=
# A long random value. Generate one with:  openssl rand -hex 32
HASH_SECRET=
# Redis connection. Added automatically when you connect Upstash Redis in the
# Vercel Marketplace (named KV_REST_API_URL / KV_REST_API_TOKEN or
# UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN; either pair works).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Optional ---
# Require a password for every analysis (personal-use mode). Empty = open to all.
ACCESS_PASSWORD=
# Plain links. Empty hides them everywhere.
DONATION_URL=
FEEDBACK_CONTACT=
# AI model. Switch to claude-sonnet-5-5 by changing this one line.
MODEL=claude-haiku-5-5
# One analysis per visitor every this many seconds.
RATE_LIMIT_SECONDS=120
MAX_CONCURRENT_ANALYSES=3
MAX_TEXT_CHARS=150000

# --- Local development only (ignored on Vercel) ---
# Use in-memory storage instead of Redis, for trying the site on your computer.
# USE_MEMORY_STORE=true
